# Dependencies
# NOTE: lockfiles are intentionally NOT ignored. The previous .gitignore
# excluded package-lock.json and yarn.lock, which made `npm ci` in CI
# impossible and every install non-deterministic. Commit them.
node_modules

# Build files
dist
# webpack output for the Netlify CMS bundle (see webpack.cms.js).
# Regenerated by `npm run build:cms`; ~4.8MB of React, never commit it.
site/static/cms.js
site/static/cms.js.map

# Hugo
public
resources
.hugo_build.lock

# OS Files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# Environment variables
# .env and friends hold real secrets and are never committed.
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# ...but the template is documentation and must be tracked.
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache

dev-debug.log
# Dependency directories
node_modules/
# Editor directories and files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# OS specific

# Local Netlify folder
.netlify

# Task files
# tasks.json
# tasks/

