# =============================================================================
# .env.example -- environment for LOCAL function testing (netlify dev)
#
# Copy to .env and fill in. `.env` is gitignored.
#
#   cp .env.example .env
#   ./ci/run.sh functions      # boots netlify dev on the CI host
#
# These are the variables the Netlify Functions actually read. Nothing here is
# needed to BUILD the site -- the static front end has no secrets.
# =============================================================================

# --- Required: authentication ------------------------------------------------
# jsonwebtoken refuses to initialise without this, and the auth middleware
# fails CLOSED (every protected endpoint 500s) rather than falling back to a
# default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Required: Supabase (PostgreSQL + REST) ----------------------------------
# Read by src/lib -> netlify/functions/lib/{database,supabase}.js and by every
# service that touches customer/lead data.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only needed for privileged server-side work (migrations, service-role access).
SUPABASE_SERVICE_ROLE_KEY=

# --- Required: PostgreSQL connection pool (used by netlify/functions/lib/database.js)
SUPABASE_PG_HOST=
SUPABASE_PG_PORT=5432
SUPABASE_PG_DATABASE=postgres
SUPABASE_PG_USER=
SUPABASE_PG_PASSWORD=

# --- Optional: Turso / libSQL (edge cache + vector search) -------------------
# @libsql/client. Used by netlify/functions/utils/{database,enhanced-database}-service.js.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional: Redis (cache layer) -------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Optional: transactional email -------------------------------------------
# nodemailer. Without it, email follow-ups log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional: lead-scoring / dedupe tuning ----------------------------------
DEDUPLICATION_THRESHOLD=0.85
LEAD_SCORE_THRESHOLD=50

# =============================================================================
# What works with NO secrets at all
# -----------------------------------------------------------------------------
# The whole static site builds and serves with none of the above. The functions
# that will respond without configuration are the pure-handler ones, e.g.
# health-check (once @libsql/client resolves) and contact-form.
#
# Everything that reads a database needs real credentials. The admin pages
# (/admin/*) render their UI shell without secrets but their dashboards fetch
# from the functions, so they will show empty/error states until the database
# env above is filled in.
# =============================================================================
