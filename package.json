{
  "name": "caddy-ed-cadillac-hugo",
  "version": "2.0.0",
  "description": "Cadillac dealership site (caddyed.com) -- Hugo Pipes front end, Netlify Functions backend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nezter/caddy-ed-cadillac-hugo.git"
  },
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "@parcel/watcher": true,
    "hugo-bin": true
  },
  "scripts": {
    "build": "node scripts/build-for-netlify.js",
    "build:production": "node scripts/build-for-netlify.js",
    "build:hugo": "hugo --source=site --destination=../site/public --minify --gc",
    "build:cms": "webpack --config webpack.cms.js",
    "verify": "node ci/verify-build.js",
    "dev": "hugo server --source=site --port 1313 --buildDrafts --buildFuture",
    "dev:hugo": "hugo server --source=site --port 1313 --buildDrafts --buildFuture",
    "dev:functions": "netlify dev --dir=site/public --functions=netlify/functions --port 8888",
    "dev:all": "npm-run-all --parallel dev:hugo dev:functions",
    "clean": "rimraf site/public site/resources dist",
    "lint": "eslint site/assets/js src scripts ci --ext .js",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm --prefix netlify/functions test",
    "test:coverage": "npm --prefix netlify/functions run test:coverage",
    "setup": "node scripts/setup-environment.js",
    "setup:turso": "node scripts/setup-turso.js",
    "migrate": "node scripts/run-migrations.js",
    "migrate:turso": "node scripts/migrate-turso.js",
    "migrate:status": "node scripts/run-migrations.js status",
    "seed:sales-reps": "node scripts/seed-sales-reps.js",
    "seed:test-data": "node scripts/seed-test-data.js",
    "seed:vehicles": "node scripts/seed-vehicles.js",
    "seed:analytics": "node scripts/seed-analytics.js",
    "seed:all": "npm run seed:sales-reps && npm run seed:test-data && npm run seed:vehicles && npm run seed:analytics"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "lazysizes": "^5.3.2",
    "netlify-cms-app": "^2.15.72",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "terser-webpack-plugin": "^5.3.11",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
