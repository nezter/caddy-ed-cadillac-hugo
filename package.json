{
  "name": "caddy-ed-cadillac-hugo",
  "version": "1.0.0",
  "description": "Website for Caddy Ed Cadillac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/caddy-ed-cadillac-hugo.git"
  },
  "main": "index.js",
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "start": "run-p start:*",
    "start:hugo": "hugo server -D -w",
    "start:webpack": "webpack serve --config webpack.dev.js",
    "preview": "npm run build:preview && hugo server -D",
    "prebuild": "rimraf dist",
    "build": "npm run prebuild && npm run build:webpack && npm run build:hugo",
    "build:enhanced": "node scripts/enhanced-build.js",
    "build:notify": "cross-env ENABLE_NOTIFICATIONS=true npm run build:enhanced",
    "build:preview": "npm run build:webpack && npm run build:hugo -- -D",
    "build:hugo": "hugo -d dist",
    "build:webpack": "webpack --config webpack.prod.js",
    "build:analyze": "webpack --config webpack.analyze.js",
    "postbuild": "node scripts/optimize-images.js",
    "generate-placeholders": "node scripts/generate-image-placeholders.js",
    "clean": "rimraf dist && rimraf site/data/webpack.json && npm run cache:clear",
    "cache:clear": "rimraf .cache && rimraf node_modules/.cache",
    "clean:node": "rimraf node_modules package-lock.json yarn.lock",
    "reinstall": "rimraf node_modules && npm install",
    "check:errors": "node scripts/check-build-errors.js",
    "lint:styles": "stylelint 'src/**/*.{css,scss}'"
  },
  "author": "Your Name",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@babel/core": "^7.16.0",
