{
  "name": "caddy-ed-cadillac-hugo",
  "version": "1.0.0",
  "description": "Cadillac dealership website built with Hugo and Webpack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/caddy-ed-cadillac-hugo.git"
  },
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run start:webpack\" \"npm run start:hugo\"",
    "start:webpack": "webpack serve --config webpack.dev.js",
    "start:hugo": "hugo server -D",
    "build": "npm run prebuild && npm run build:webpack && npm run build:hugo && npm run postbuild",
    "build:enhanced": "node scripts/enhanced-build.js",
    "build:notify": "node scripts/enhanced-build.js --notify",
    "build:webpack": "webpack --config webpack.prod.js",
    "build:hugo": "hugo",
    "build:analyze": "webpack --config webpack.analyze.js",
    "build:critical": "node scripts/build-with-critical-css.js",
    "prebuild": "rimraf dist",
    "postbuild": "npm run optimize",
    "optimize": "node scripts/optimize-assets.js",
    "check:errors": "node scripts/check-build-errors.js",
    "cache:clear": "rimraf .cache",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf dist .cache",
    "reinstall": "rimraf node_modules package-lock.json && npm install",
    "preview": "hugo -D && http-server ./dist",
    "critical-css": "node scripts/generate-critical-css.js"
  },
  "author": "Your Name",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "axios": "^0.21.1",
    "lazysizes": "^5.3.2",
    "nouislider": "^15.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.6",
    "@babel/eslint-parser": "^7.14.7",
    "@babel/preset-env": "^7.14.7",
    "assets-webpack-plugin": "^7.1.1",
    "autoprefixer": "^10.2.6",
    "babel-loader": "^8.2.2",
    "chalk": "^4.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^8.0.1",
    "concurrently": "^6.2.0",
    "copy-webpack-plugin": "^9.0.1",
    "critical": "^4.0.1",
    "critical-css-inline-webpack-plugin": "^1.0.0",
    "css-loader": "^5.2.6",
    "css-minimizer-webpack-plugin": "^3.0.2",
    "dotenv": "^10.0.0",
    "eslint": "^7.30.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-webpack-plugin": "^2.5.4",
    "exports-loader": "^3.0.0",
    "file-loader": "^6.2.0",
    "glob": "^7.1.7",
    "html-critical-webpack-plugin": "^2.1.0",
    "html-webpack-plugin": "^5.5.0",
    "http-server": "^14.0.0",
    "hugo-bin": "^0.80.0",
    "imports-loader": "^3.1.0",
    "json-loader": "^0.5.7",
    "mini-css-extract-plugin": "^2.1.0",
    "node-notifier": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "penthouse": "^2.3.2",
    "postcss": "^8.3.5",
    "postcss-import": "^14.0.2",
    "postcss-loader": "^6.1.1",
    "postcss-preset-env": "^6.7.0",
    "rimraf": "^3.0.2",
    "sass": "^1.43.4",
    "sass-loader": "^13.0.0",
    "style-loader": "^3.0.0",
    "terser-webpack-plugin": "^5.1.4",
    "webpack": "^5.42.0",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "^4.7.2",
    "webpack-dev-server": "^4.0.0",
    "webpack-manifest-plugin": "^4.0.2",
    "webpack-merge": "^5.8.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
