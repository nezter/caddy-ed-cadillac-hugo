# npm 11 (Node 24) refuses to run dependency lifecycle scripts unless they are
# explicitly allowlisted. The allowlist lives in the `allowScripts` field of
# package.json -- deliberately NOT here.
#
# Reason: when you run `npm run <script>`, npm injects every .npmrc key into the
# child process as `npm_config_<key>`. An `allow-scripts` key here therefore
# reaches the nested `npm install` as an env/CLI flag, and npm 11 rejects that
# form for project-scoped installs:
#
#     npm error code EALLOWSCRIPTS
#     npm error --allow-scripts is not allowed in project-scoped installs.
#
# The package.json `allowScripts` field is not converted to an env var, so it
# works in both direct and nested installs. This broke `npm run build`.

# Reproducibility: commit lockfiles. (The old .gitignore excluded them, which
# made `npm ci` in CI impossible and every install non-deterministic.)
package-lock=true
save-exact=false

# Faster, quieter, and avoids the interactive fund/audit prompts that hang CI.
fund=false
audit=false
update-notifier=false
