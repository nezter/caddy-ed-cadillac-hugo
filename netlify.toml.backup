# Netlify Configuration for Cadillac of South Charlotte
# Optimized for Hugo site with Netlify Functions

[build]
  # Build command for Hugo
  command = "hugo --gc --minify"
  
  # Directory containing the built site
  publish = "public"
  
  # Directory containing Netlify Functions
  functions = "netlify/functions"
  
  # Environment variables during build
  [build.environment]
    HUGO_VERSION = "0.119.0"
    NODE_VERSION = "18"
    GO_VERSION = "1.19"

# Build context-specific settings
[context.production]
  command = "hugo --gc --minify"
  
[context.deploy-preview]
  command = "hugo --gc --minify --buildDrafts --buildFuture"
  
[context.branch-deploy]
  command = "hugo --gc --minify"

# Redirects for SEO and URL structure
[[redirects]]
  from = "/api/*"
  to = "/.netlify/functions/:splat"
  status = 200

[[redirects]]
  from = "/health"
  to = "/.netlify/functions/health-check"
  status = 200

[[redirects]]
  from = "/health/*"
  to = "/.netlify/functions/health-check/:splat"
  status = 200

# Legacy redirects
[[redirects]]
  from = "/inventory"
  to = "/inventory/"
  status = 301

[[redirects]]
  from = "/schedule"
  to = "/schedule-service/"
  status = 301

[[redirects]]
  from = "/contact"
  to = "/contact-us/"
  status = 301

# Headers for security and performance
[[headers]]
  for = "/*"
  [headers.values]
    X-Frame-Options = "DENY"
    X-XSS-Protection = "1; mode=block"
    X-Content-Type-Options = "nosniff"
    Referrer-Policy = "strict-origin-when-cross-origin"
    Permissions-Policy = "camera=(), microphone=(), geolocation=()"
    Strict-Transport-Security = "max-age=31536000; includeSubDomains; preload"

[[headers]]
  for = "/static/*"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "*.css"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "*.js"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "*.png"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "*.jpg"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "*.jpeg"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "*.webp"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "*.svg"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "*.woff"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "*.woff2"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "/.netlify/functions/*"
  [headers.values]
    Cache-Control = "no-cache, no-store, must-revalidate"
    Pragma = "no-cache"
    Expires = "0"

# Rate limiting for API endpoints
[[edge_functions]]
  path = "/.netlify/functions/*"
  function = "rate-limit"

# Environment variables
[dev]
  command = "hugo server -D -F --bind 0.0.0.0 --port 1313"
  publish = "public"
  functions = "netlify/functions"
  autoLaunch = false

# Plugin configurations temporarily disabled for local development
# [[plugins]]
# package = "@netlify/plugin-lighthouse"
    
    # Search engines to notify
    providers = [
      "google",
      "bing"
    ]
    
    # Delay before submission (in seconds)
    delay = 10

# Function-specific configuration
[functions]
# Directory containing functions
directory = "netlify/functions"

# Node.js version for functions
node_version = "18"

# Memory allocation for functions
memory = 1024

# Maximum execution time (in seconds)
max_duration = 30

# Specific function configurations
[[functions]]
path = "followup-campaigns"

[functions.schedule]
# Run cleanup function daily at 2 AM UTC
cron = "0 2 * * *"

[[functions]]
path = "health-check"

[functions.schedule]
# Run health check every 5 minutes
cron = "*/5 * * * *"

# Environment variables for different contexts
[context.production.environment]
  NODE_ENV = "production"
  HUGO_ENV = "production"

[context.deploy-preview.environment]
  NODE_ENV = "development"
  HUGO_ENV = "development"

[context.branch-deploy.environment]
  NODE_ENV = "staging"
  HUGO_ENV = "staging"

# Redirect rules for API versioning
[[redirects]]
  from = "/api/v1/*"
  to = "/.netlify/functions/:splat"
  status = 200

[[redirects]]
  from = "/api/v2/*"
  to = "/.netlify/functions/:splat"
  status = 200

# Error pages
[error_pages]
  404 = "/404.html"
  500 = "/500.html"

# Asset optimization
[build.processing]
  skip_processing = false
  
  [build.processing.css]
    bundle = true
    minify = true
    
  [build.processing.js]
    bundle = true
    minify = true
    
  [build.processing.html]
    pretty_urls = true
    
  [build.processing.images]
    compress = true

# Post-processing
[build.processing.post_processing]
  # Optimize images
  [[build.processing.post_processing.image]]
    ext = ["png", "jpg", "jpeg", "webp"]
    compress = true
    quality = 80

# Security headers for API endpoints
[[headers]]
  for = "/.netlify/functions/followup-*"
  [headers.values]
    Access-Control-Allow-Origin = "https://cadillac-of-south-charlotte.netlify.app"
    Access-Control-Allow-Methods = "GET, POST, PUT, DELETE, OPTIONS"
    Access-Control-Allow-Headers = "Content-Type, Authorization, X-Requested-With"
    Access-Control-Allow-Credentials = "true"
    Content-Security-Policy = "default-src 'self'"

# Cache busting for static assets
[[redirects]]
  from = "/css/*"
  to = "/static/css/:splat"
  status = 200

[[redirects]]
  from = "/js/*"
  to = "/static/js/:splat"
  status = 200

[[redirects]]
  from = "/fonts/*"
  to = "/static/fonts/:splat"
  status = 200

# Maintenance mode configuration
[context.branch-deploy]
  [context.branch-deploy.environment]
    MAINTENANCE_MODE = "false"

# Analytics and monitoring
[build.processing.post_processing]
  # Add analytics tracking
  [[build.processing.post_processing.html]]
    ext = "html"
    # Add any HTML post-processing here